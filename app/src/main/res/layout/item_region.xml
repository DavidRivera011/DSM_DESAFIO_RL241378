<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#E8F0F8"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#DCE5EF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/regionNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#17212B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="América" />

        <TextView
            android:id="@+id/regionSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#65717E"
            android:textSize="14sp"
            android:text="Ver países · Americas" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
