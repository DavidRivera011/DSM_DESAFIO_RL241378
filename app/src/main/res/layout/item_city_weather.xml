<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/country_detail_card"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cityWeatherName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre de ciudad"
            android:textColor="#202B38"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/cityWeatherIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Icono del clima"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <TextView
        android:id="@+id/cityWeatherTemperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-- °C"
        android:textColor="#244F89"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cityWeatherCondition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consultando clima..."
        android:textColor="#65717E"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cityWeatherHumidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Humedad: --"
        android:textColor="#354454"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cityWeatherWind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Viento: --"
        android:textColor="#354454"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnLocateCity"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="Ver en mapa"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4779B8" />

</LinearLayout>
