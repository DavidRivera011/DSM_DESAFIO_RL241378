<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver a países"
            android:textAllCaps="false"
            android:backgroundTint="#E6D5F5"
            android:textColor="#51416A" />

        <!-- Tarjeta de información del país -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/country_detail_card"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/detailCountryFlag"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:contentDescription="Bandera del país"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/detailCountryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nombre del país"
                android:textColor="#202B38"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailOfficialName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nombre oficial:"
                android:textColor="#65717E"
                android:textSize="14sp" />

            <!-- Información organizada en filas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailCapital"
                    style="@style/CountryDetailRow"
                    android:text="Capital:" />

                <TextView
                    android:id="@+id/detailRegion"
                    style="@style/CountryDetailRow"
                    android:text="Región:" />

                <TextView
                    android:id="@+id/detailSubregion"
                    style="@style/CountryDetailRow"
                    android:text="Subregión:" />

                <TextView
                    android:id="@+id/detailPopulation"
                    style="@style/CountryDetailRow"
                    android:text="Población:" />

                <TextView
                    android:id="@+id/detailCodes"
                    style="@style/CountryDetailRow"
                    android:text="Códigos ISO:" />

                <TextView
                    android:id="@+id/detailCurrencies"
                    style="@style/CountryDetailRow"
                    android:text="Monedas:" />

                <TextView
                    android:id="@+id/detailLanguages"
                    style="@style/CountryDetailRow"
                    android:text="Idiomas:" />

                <TextView
                    android:id="@+id/detailCoordinates"
                    style="@style/CountryDetailRow"
                    android:text="Coordenadas:" />

            </LinearLayout>
        </LinearLayout>

        <!-- Mapa -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Mapa de ciudades"
            android:textColor="#244F89"
            android:textSize="19sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:background="#DCE8F2">

            <org.osmdroid.views.MapView
                android:id="@+id/countryMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/mapProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mapMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#DDFFFFFF"
                android:padding="10dp"
                android:gravity="center"
                android:text="Preparando mapa..."
                android:textColor="#34495E"
                android:textSize="13sp" />

        </FrameLayout>

        <TextView
            android:id="@+id/citiesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Ciudades principales"
            android:textColor="#65717E"
            android:textSize="13sp" />

        <!-- Lista de ciudades y clima -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:text="Clima de las ciudades"
            android:textColor="#244F89"
            android:textSize="19sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/citiesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>
</ScrollView>
